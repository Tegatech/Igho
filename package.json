{
  "name": "igho",
  "version": "0.1.0",
  "private": true,
  "description": "Igho payroll orchestration platform",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" package.json \"tsconfig*.json\" eslint.config.mjs \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" package.json \"tsconfig*.json\" eslint.config.mjs \".github/workflows/*.yml\"",
    "typecheck": "tsc -b",
    "quality": "npm run format:check && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
