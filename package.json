{
  "name": "igho",
  "version": "0.1.0",
  "private": true,
  "description": "Igho payroll orchestration platform",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" package.json \"tsconfig*.json\" eslint.config.mjs vitest.config.ts \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" package.json \"tsconfig*.json\" eslint.config.mjs vitest.config.ts \".github/workflows/*.yml\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^5.0.1"
  }
}
