{
  "name": "igho",
  "version": "0.1.0",
  "private": true,
  "description": "Igho payroll orchestration platform",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "functions/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @igho/igho-api",
    "lint": "eslint \"functions/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "format": "prettier --write \"functions/**/*.{ts,tsx,json,mjs}\" \"packages/**/*.{ts,tsx,json}\" package.json catalyst.json \"tsconfig*.json\" eslint.config.mjs vitest.config.ts \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"functions/**/*.{ts,tsx,json,mjs}\" \"packages/**/*.{ts,tsx,json}\" package.json catalyst.json \"tsconfig*.json\" eslint.config.mjs vitest.config.ts \".github/workflows/*.yml\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "esbuild": "^0.25.10",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^5.0.1",
    "vite": "^7.1.7"
  }
}
